{
    "schemaVersion": 1,
    "id": "civmodern",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": "%FABRIC_AUTHORS_ARRAY%",
    "contact": {
        "homepage": "${mod_home_url}",
        "sources": "${mod_source_url}"
    },
    "license": "${copyright_licence}",
    "icon": "assets/civmodern/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "sh.okx.civmodern.fabric.FabricCivModernBootstrap"
        ],
        "modmenu": [
            "sh.okx.civmodern.fabric.integrations.modmenu.ModMenuIntegration"
        ]
    },
    "depends": {
        "minecraft": "${minecraft_version}",
        "fabricloader": ">=${fabric_loader_version}",
        "fabric": "*"
    },
    "mixins": [
        "civmodern.common.mixins.json"
    ],
    "accessWidener": "civmodern.accesswidener",
    "custom": {
        "loom:injected_interfaces": {
            "net/minecraft/class_339": [
                "sh/okx/civmodern/common/ui/inject/UIComponentStub"
            ],
            "net/minecraft/class_342": [
                "sh/okx/civmodern/common/ui/inject/GreedyInputUIComponent"
            ],
            "net/minecraft/class_332": [
                "sh/okx/civmodern/common/ui/util/MatrixStackTransformer"
            ]
        }
    }
}
